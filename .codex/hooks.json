{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/graph_audit.py\" --hook",
            "statusMessage": "Checking the knowledge graph",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
